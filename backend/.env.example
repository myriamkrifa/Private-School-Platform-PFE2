# Server
PORT=5000
JWT_SECRET=replace_with_a_strong_secret_key
CLIENT_URL=http://localhost:5173
APP_NAME=EduManage

# Firebase Admin (Google SSO) — copy firebase-service-account.example.json to
# firebase-service-account.json and fill from Firebase Console → Project settings → Service accounts
# FIREBASE_SERVICE_ACCOUNT_PATH=./src/config/firebase-service-account.json

# Database (MySQL)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/private_school_db"

# SMTP (optional — emails are skipped if SMTP_HOST is not set)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM="EduManage" <noreply@example.com>

# AI Assistant — use OpenAI and/or Google Gemini (server-side only; never expose to frontend)
# At least one key enables full answers on any topic.
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Gemini (free tier — https://aistudio.google.com/apikey)
# Or paste the key in AI Assistant → "Enable full AI"
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional local LLM (no cloud key) — https://ollama.com
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
